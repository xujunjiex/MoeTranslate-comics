<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- 图片翻页 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部页码 -->
    <TextView
        android:id="@+id/tvPageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="#80000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp" />

    <!-- 关闭按钮 -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#FFFFFF" />

    <!-- 删除按钮 -->
    <ImageButton
        android:id="@+id/btnDeleteEntry"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="#FFFF6B6B"
        android:contentDescription="@string/delete" />

    <!-- 尺寸切换按钮栏 -->
    <LinearLayout
        android:id="@+id/sizeSwitcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#66000000"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:visibility="gone" />

    <!-- 底部查看译文按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShowTranslation"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="120dp"
        android:text="@string/show_translation"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:backgroundTint="#CC333333"
        app:cornerRadius="20dp"
        app:icon="@android:drawable/ic_menu_sort_by_size"
        app:iconTint="#FFFFFF" />

    <!-- 底部操作栏 (重新翻译 / 删除 / 尺寸切换) -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/variantSelectorLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_variant_size_label"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/spinnerVariant"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnRetranslate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/history_retranslate"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDeleteVariant"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/history_delete_variant" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部译文面板 -->
    <LinearLayout
        android:id="@+id/bottomSheetPanel"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#F0222222"
        android:elevation="8dp">

        <!-- 拖拽条 -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#66FFFFFF" />

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/translation_detail"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseSheet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 翻译信息栏 -->
        <TextView
            android:id="@+id/tvTranslationInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="6dp"
            android:textColor="#88FFFFFF"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp" />

        <!-- 译文内容列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTranslationDetail"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false" />

    </LinearLayout>

</FrameLayout>
